# ---------- Generation ----------
# Track B (W17) runs every experiment, the regression suite and the LLM judge on
# Groq, model openai/gpt-oss-120b. Copy this file to .env and set GROQ_API_KEY.
#
# local  = keyless deterministic demo (no model call, heuristic tool selection)
# ollama = a model running locally via Ollama: no key, no cost
# openai = hosted OpenAI-compatible API
# vllm   = self-hosted vLLM OpenAI-compatible server
# groq   = hosted Groq, OpenAI-compatible (the W17 experiments use this)
PROVIDER=groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Used when the primary provider fails. "none" disables fail-over, which Track B
# needs: every number must come from one model. (The runner forces it anyway.)
FALLBACK_PROVIDER=none
FALLBACK_MODEL=gpt-4o-mini

# ---------- Embeddings ----------
# onnx   = BAAI/bge-small-en-v1.5 on ONNX Runtime, no API key (default)
# openai = hosted text-embedding-3-small
# hash   = deterministic test double, no downloads
EMBEDDING_PROVIDER=onnx
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_CACHE_DIR=.cache/fastembed

# ---------- Retrieval ----------
DATA_DIR=data
CHROMA_DIR=data/chroma
COLLECTION_NAME=knowledge
CHUNK_SIZE_WORDS=180
CHUNK_OVERLAP_WORDS=40
TOP_K=4
MIN_SCORE=0.15
INGEST_BATCH_SIZE=512
EMBEDDING_BATCH_SIZE=32
# Extra comma-separated globs (relative to DATA_DIR) to keep out of the index.
EXCLUDED_GLOBS=

# ---------- Tools ----------
MAX_TOOL_ITERATIONS=4
TOOL_TIMEOUT_SECONDS=20

# ---------- Agentic pattern ----------
# single = the tool-calling loop; multi = planner + parallel researchers + synthesiser
AGENT_MODE=single
MAX_RESEARCHERS=3
RESEARCHER_MAX_ITERATIONS=3
RESEARCHER_TOP_K=5
# Tool results kept verbatim; anything older is compacted to its citations.
COMPACTION_KEEP_RAW=1

# ---------- Failure injection (evaluation only) ----------
# "", tool_unavailable, malformed_retrieval, retrieval_timeout
FAULT_INJECTION=

# ---------- Reliability / performance ----------
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=512
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_LLM_CALLS=8
# Sleep before a call when Groq's x-ratelimit-* headers say it won't fit the minute.
PACE_FROM_HEADERS=true
# gpt-oss reasoning depth on Groq: low | medium | high (the runner logs its own value).
REASONING_EFFORT=low
